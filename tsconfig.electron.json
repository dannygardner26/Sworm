{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "app-dist",
    "rootDir": "app",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["app/**/*.ts"],
  "exclude": ["app/renderer/**"]
}
