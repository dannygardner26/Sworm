{
  "name": "sworm",
  "version": "0.2.0",
  "description": "Spatially-aware desktop orchestration — deploy AI agents and apps across multi-monitor setups via named formations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sworm": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "app": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "swarm",
    "orchestration",
    "multi-monitor",
    "window-management",
    "ai-agents",
    "formations"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "electron": "^41.1.0",
    "eventemitter3": "^5.0.4",
    "koffi": "^2.15.2",
    "node-pty": "^1.1.0",
    "ora": "^9.3.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron-builder": "^26.8.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
